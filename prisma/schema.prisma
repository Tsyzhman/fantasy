generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ImportStatus {
  EMPTY
  UPLOADING
  PARSING
  VALIDATED
  READY
  PUBLISHED
  ERROR
  OUTDATED
  ARCHIVED
}

enum DataSourceType {
  WYSCOUT_EXCEL
  API_FOOTBALL
  WYSCOUT_API
  MANUAL
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  name               String?
  passwordHash       String?
  role               UserRole                @default(USER)
  isActive           Boolean                 @default(true)
  lastLoginAt        DateTime?
  sessions           UserSession[]
  fantasySquads      UserFantasySquad[]
  betaTestRuns       BetaTestRun[]
  savedViews         UserSavedView[]
  watchlistPlayers   UserWatchlistPlayer[]
  scoringPreferences UserScoringPreference[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model UserScoringPreference {
  id                        String   @id @default(cuid())
  userId                    String
  modelSource               String
  scoringFormulaGk          String?
  scoringFormulaDef         String?
  scoringFormulaMid         String?
  scoringFormulaFwd         String?
  scoringFormulaEnabled     Boolean  @default(false)
  alternativeFormulaGk      String?
  alternativeFormulaDef     String?
  alternativeFormulaMid     String?
  alternativeFormulaFwd     String?
  alternativeFormulaEnabled Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelSource])
  @@index([modelSource, updatedAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  id           String    @id
  action       String
  subjectHash  String
  failedCount  Int       @default(0)
  lastFailedAt DateTime?
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@unique([action, subjectHash])
  @@index([lockedUntil])
}

model League {
  id                      String                   @id @default(cuid())
  name                    String
  country                 String?
  code                    String?
  logoUrl                 String?
  seasons                 Season[]
  teams                   Team[]
  imports                 TeamImport[]
  snapshots               PlayerSnapshot[]
  baltikaFixtures         BaltikaFixture[]
  baltikaTeamStatsImports BaltikaTeamStatsImport[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Season {
  id                      String                   @id @default(cuid())
  leagueId                String
  name                    String
  startDate               DateTime?
  endDate                 DateTime?
  league                  League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  imports                 TeamImport[]
  snapshots               PlayerSnapshot[]
  baltikaFixtures         BaltikaFixture[]
  baltikaTeamStatsImports BaltikaTeamStatsImport[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([leagueId, name])
}

model Team {
  id                      String                   @id @default(cuid())
  leagueId                String
  name                    String
  slug                    String
  logoUrl                 String?
  aliases                 String[]                 @default([])
  league                  League                   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  imports                 TeamImport[]
  snapshots               PlayerSnapshot[]
  baltikaFixturesHome     BaltikaFixture[]         @relation("BaltikaFixtureHomeTeam")
  baltikaFixturesAway     BaltikaFixture[]         @relation("BaltikaFixtureAwayTeam")
  baltikaTeamStatsImports BaltikaTeamStatsImport[]
  baltikaMatchStats       BaltikaTeamMatchStat[]   @relation("BaltikaTeamMatchStatTeam")
  baltikaOpponentStats    BaltikaTeamMatchStat[]   @relation("BaltikaTeamMatchStatOpponent")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([leagueId, slug])
}

model SourceFile {
  id                      String                   @id @default(cuid())
  sourceType              DataSourceType           @default(WYSCOUT_EXCEL)
  originalFilename        String
  storagePath             String
  mimeType                String?
  sizeBytes               Int?
  checksum                String?
  uploadedById            String?
  imports                 TeamImport[]
  baltikaTeamStatsImports BaltikaTeamStatsImport[]
  createdAt               DateTime                 @default(now())

  @@index([checksum])
}

model TeamImport {
  id                 String       @id @default(cuid())
  leagueId           String
  seasonId           String
  teamId             String
  sourceFileId       String
  status             ImportStatus @default(PARSING)
  periodFrom         DateTime?
  periodTo           DateTime?
  detectedTeamName   String?
  rowsCount          Int          @default(0)
  columnsCount       Int          @default(0)
  errorsJson         Json?
  warningsJson       Json?
  isCurrentPublished Boolean      @default(false)
  publishedAt        DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  league     League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season     Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceFile SourceFile       @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  snapshots  PlayerSnapshot[]

  @@index([leagueId, seasonId, teamId, status])
  @@index([teamId, isCurrentPublished])
}

model Player {
  id              String   @id @default(cuid())
  canonicalName   String
  normalizedName  String
  birthCountry    String?
  passportCountry String?
  foot            String?
  heightCm        Int?
  weightKg        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots PlayerSnapshot[]

  @@index([normalizedName])
}

model PlayerSnapshot {
  id           String  @id @default(cuid())
  teamImportId String
  leagueId     String
  seasonId     String
  teamId       String
  playerId     String?

  playerName      String
  normalizedName  String
  teamName        String
  positionRaw     String?
  positionGroup   String?
  age             Int?
  marketValue     Int?
  contractExpires DateTime?
  matchesPlayed   Int?
  minutesPlayed   Int?
  goals           Float?
  xg              Float?
  assists         Float?
  xa              Float?
  birthCountry    String?
  passportCountry String?
  foot            String?
  heightCm        Int?
  weightKg        Int?
  onLoan          Boolean?

  fantasyScore      Float?
  scoringScore      Float?
  alternativeScore  Float?
  valueScore        Float?
  isStarter         Boolean @default(false)
  fantasyAssists    Int?    @map("fantasy_assists")
  cleanSheets       Int?    @map("clean_sheets")
  saves             Int?
  penaltySaves      Int?    @map("penalty_saves")
  recoveries        Int?
  penaltiesConceded Int?    @map("penalties_conceded")
  missedPenalties   Int?    @map("missed_penalties")
  ownGoals          Int?    @map("own_goals")
  goalsConceded     Int?    @map("goals_conceded")
  shotsOnTarget     Int?    @map("shots_on_target")
  keyPasses         Int?    @map("key_passes")
  tacklesWon        Int?    @map("tackles_won")
  interceptions     Int?
  clearances        Int?
  yellowCards       Int?    @map("yellow_cards")
  redCards          Int?    @map("red_cards")
  averageRating     Float?  @map("average_rating")

  createdAt DateTime @default(now())

  teamImport TeamImport @relation(fields: [teamImportId], references: [id], onDelete: Cascade)
  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season     Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id])

  @@index([leagueId, seasonId, teamId])
  @@index([positionGroup])
  @@index([fantasyScore])
  @@index([scoringScore])
  @@index([alternativeScore])
  @@index([valueScore])
  @@index([isStarter])
}

model FantasyModel {
  id                        String             @id @default(cuid())
  modelSource               String             @default("WYSCOUT")
  name                      String
  description               String?
  version                   Int                @default(1)
  isDefault                 Boolean            @default(false)
  isActive                  Boolean            @default(true)
  customFormula             String?
  customFormulaGk           String?
  customFormulaDef          String?
  customFormulaMid          String?
  customFormulaFwd          String?
  customFormulaEnabled      Boolean            @default(false)
  scoringFormulaGk          String?
  scoringFormulaDef         String?
  scoringFormulaMid         String?
  scoringFormulaFwd         String?
  scoringFormulaEnabled     Boolean            @default(false)
  alternativeFormulaGk      String?
  alternativeFormulaDef     String?
  alternativeFormulaMid     String?
  alternativeFormulaFwd     String?
  alternativeFormulaEnabled Boolean            @default(false)
  rules                     FantasyModelRule[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([modelSource, isDefault, isActive])
}

model FantasyModelRule {
  id            String  @id @default(cuid())
  modelId       String
  positionGroup String
  metricKey     String
  weight        Float
  transform     String  @default("linear")
  enabled       Boolean @default(true)

  model FantasyModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, positionGroup])
}

model FantasyBacktestRun {
  id               String    @id @default(cuid())
  leagueId         BigInt    @map("league_id")
  season           String
  modelSource      String    @default("MACHETE") @map("model_source")
  modelName        String    @map("model_name")
  modelVersion     String    @map("model_version")
  modelHash        String    @map("model_hash")
  baseline         String
  historyMatches   Int       @map("history_matches")
  minimumHistory   Int       @map("minimum_history")
  expectedMatches  Int?      @map("expected_matches")
  finishedMatches  Int       @map("finished_matches")
  seasonComplete   Boolean   @default(false) @map("season_complete")
  sampleSize       Int       @default(0) @map("sample_size")
  modelMae         Float?    @map("model_mae")
  baselineMae      Float?    @map("baseline_mae")
  modelRmse        Float?    @map("model_rmse")
  baselineRmse     Float?    @map("baseline_rmse")
  passingPositions Int       @default(0) @map("passing_positions")
  gatePassed       Boolean   @default(false) @map("gate_passed")
  status           String    @default("RUNNING")
  configuration    Json
  report           Json?
  error            String?
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([leagueId, season, createdAt])
  @@index([modelHash, createdAt])
  @@index([status, createdAt])
  @@map("fantasy_backtest_runs")
}

model DataQualityAuditRun {
  id                       String    @id @default(cuid())
  leagueId                 BigInt    @map("league_id")
  season                   String
  modelVersion             String    @map("model_version")
  modelHash                String    @map("model_hash")
  coverageThreshold        Float     @default(98) @map("coverage_threshold")
  maximumLatencyHours      Float     @default(6) @map("maximum_latency_hours")
  activePlayers            Int       @default(0) @map("active_players")
  forecastsAvailable       Int       @default(0) @map("forecasts_available")
  forecastCoverage         Float     @default(0) @map("forecast_coverage")
  playersWithBasicStats    Int       @default(0) @map("players_with_basic_stats")
  playerDataCoverage       Float     @default(0) @map("player_data_coverage")
  finishedMatches          Int       @default(0) @map("finished_matches")
  matchesWithPlayerStats   Int       @default(0) @map("matches_with_player_stats")
  matchDataCoverage        Float     @default(0) @map("match_data_coverage")
  statRows                 Int       @default(0) @map("stat_rows")
  completeStatRows         Int       @default(0) @map("complete_stat_rows")
  statRowCoverage          Float     @default(0) @map("stat_row_coverage")
  matchesPromotedInTime    Int       @default(0) @map("matches_promoted_in_time")
  promotionLatencyCoverage Float     @default(0) @map("promotion_latency_coverage")
  gatePassed               Boolean   @default(false) @map("gate_passed")
  status                   String    @default("RUNNING")
  report                   Json?
  error                    String?
  startedAt                DateTime  @default(now()) @map("started_at")
  completedAt              DateTime? @map("completed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([leagueId, season, createdAt])
  @@index([status, createdAt])
  @@index([gatePassed, createdAt])
  @@map("data_quality_audit_runs")
}

model BetaTestRun {
  id                       String    @id
  userId                   String    @map("user_id")
  deviceClass              String    @map("device_class")
  viewportWidth            Int       @map("viewport_width")
  synthetic                Boolean   @default(false)
  valid                    Boolean?
  withoutHelp              Boolean?  @map("without_help")
  transferReasonUnderstood Boolean?  @map("transfer_reason_understood")
  usabilityRating          Int?      @map("usability_rating")
  criticalIssue            Boolean?  @map("critical_issue")
  moderatedEnvironment     String?   @map("moderated_environment")
  invalidReason            String?   @map("invalid_reason")
  moderatorNotes           String?   @map("moderator_notes")
  submittedAt              DateTime? @map("submitted_at")
  reviewedAt               DateTime? @map("reviewed_at")
  startedAt                DateTime  @default(now()) @map("started_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations BetaTestObservation[]

  @@index([userId, startedAt])
  @@index([synthetic, valid, startedAt])
  @@map("beta_test_runs")
}

model BetaTestObservation {
  id        BigInt   @id @default(autoincrement())
  runId     String   @map("run_id")
  kind      String
  name      String
  route     String   @default("")
  value     Float?
  rating    String?
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run BetaTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, kind, name, route])
  @@index([kind, name, createdAt])
  @@index([runId, createdAt])
  @@map("beta_test_observations")
}

model ClientCriticalErrorEvent {
  id             BigInt   @id @default(autoincrement())
  kind           String
  routeGroup     String   @map("route_group")
  occurredMinute DateTime @map("occurred_minute")
  count          Int      @default(1)

  @@unique([kind, routeGroup, occurredMinute])
  @@index([occurredMinute])
  @@map("client_critical_error_events")
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  filters   Json
  createdAt DateTime @default(now())
}

model Shortlist {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MacheteLeague {
  id               String    @id @default(cuid())
  provider         String    @default("FOTMOB")
  providerLeagueId String?   @unique
  name             String
  country          String?
  season           String?
  logoUrl          String?
  status           String    @default("NOT_CONFIGURED")
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  teams    MacheteTeam[]
  fixtures MacheteFixture[]
  syncJobs MacheteSyncJob[]
}

model MacheteTeam {
  id             String    @id @default(cuid())
  leagueId       String
  provider       String    @default("FOTMOB")
  providerTeamId String?
  name           String
  shortName      String?
  country        String?
  logoUrl        String?
  status         String    @default("NOT_CONFIGURED")
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  league       MacheteLeague    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  players      MachetePlayer[]
  fixturesHome MacheteFixture[] @relation("MacheteFixtureHomeTeam")
  fixturesAway MacheteFixture[] @relation("MacheteFixtureAwayTeam")
  syncJobs     MacheteSyncJob[]

  @@unique([provider, providerTeamId])
  @@index([leagueId, status])
}

model MachetePlayer {
  id               String    @id @default(cuid())
  teamId           String?
  provider         String    @default("FOTMOB")
  providerPlayerId String?
  name             String
  position         String?
  age              Int?
  nationality      String?
  height           String?
  foot             String?
  photoUrl         String?
  status           String    @default("ACTIVE")
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  team       MacheteTeam?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matchStats MachetePlayerMatchStat[]
  snapshots  MachetePlayerSnapshot[]

  @@unique([provider, providerPlayerId])
  @@index([teamId])
}

model MacheteFixture {
  id                String    @id @default(cuid())
  leagueId          String
  provider          String    @default("FOTMOB")
  providerFixtureId String?
  homeTeamId        String?
  awayTeamId        String?
  kickoffAt         DateTime?
  status            String?
  round             String?
  aggregateSeason   String?   @map("aggregate_season")
  homeScore         Int?
  awayScore         Int?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  league      MacheteLeague            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam    MacheteTeam?             @relation("MacheteFixtureHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam    MacheteTeam?             @relation("MacheteFixtureAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  playerStats MachetePlayerMatchStat[]

  @@unique([provider, providerFixtureId])
  @@index([leagueId, kickoffAt])
}

model CoreLeague {
  id        BigInt   @id
  name      String
  country   String?
  source    String   @default("fotmob")
  rawRef    String?  @map("raw_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  matches         CoreMatch[]
  seasons         LeagueSeason[]
  fantasyContests SportsRuFantasyContest[]
  fantasyPrices   FantasyPlayerPrice[]
  fantasySquads   UserFantasySquad[]

  @@index([source, rawRef])
  @@map("leagues")
}

model CoreTeam {
  id        BigInt   @id
  name      String
  country   String?
  ccode     String?
  source    String   @default("fotmob")
  rawRef    String?  @map("raw_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  homeMatches         CoreMatch[]              @relation("CoreMatchHomeTeam")
  awayMatches         CoreMatch[]              @relation("CoreMatchAwayTeam")
  teamStats           MatchTeamStat[]          @relation("MatchTeamStatsTeam")
  opponentTeamStats   MatchTeamStat[]          @relation("MatchTeamStatsOpponentTeam")
  playerStats         MatchPlayerStat[]        @relation("MatchPlayerStatsTeam")
  opponentPlayerStats MatchPlayerStat[]        @relation("MatchPlayerStatsOpponentTeam")
  events              MatchEvent[]
  shotsFor            MatchShot[]              @relation("MatchShotTeam")
  shotsAgainst        MatchShot[]              @relation("MatchShotOpponentTeam")
  leagueSeasonTeams   LeagueSeasonTeam[]
  seasonRosterEntries TeamPlayerSeason[]
  fantasyPrices       FantasyPlayerPrice[]
  fantasySquadPlayers UserFantasySquadPlayer[]

  @@index([source, rawRef])
  @@map("teams")
}

model CorePlayer {
  id        BigInt    @id
  name      String
  country   String?
  birthDate DateTime? @map("birth_date") @db.Date
  source    String    @default("fotmob")
  rawRef    String?   @map("raw_ref")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  stats                  MatchPlayerStat[]
  events                 MatchEvent[]             @relation("MatchEventPlayer")
  relatedEvents          MatchEvent[]             @relation("MatchEventRelatedPlayer")
  shots                  MatchShot[]
  fantasyPoints          FantasyPoint[]
  fantasyPointBreakdowns FantasyPointBreakdown[]
  seasonRosterEntries    TeamPlayerSeason[]
  fantasyPrices          FantasyPlayerPrice[]
  fantasySquadPlayers    UserFantasySquadPlayer[]

  @@index([source, rawRef])
  @@map("players")
}

model SportsRuFantasyContest {
  id                String    @id @default(cuid())
  leagueId          BigInt    @map("league_id")
  season            String
  provider          String    @default("SPORTS_RU")
  providerContestId String?   @map("provider_contest_id")
  slug              String?
  name              String
  budgetLimit       Float     @default(100) @map("budget_limit")
  squadSize         Int       @default(15) @map("squad_size")
  maxPlayersPerTeam Int       @default(2) @map("max_players_per_team")
  rules             Json?
  sourceUrl         String?   @map("source_url")
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  league CoreLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([provider, leagueId, season])
  @@index([leagueId, season])
  @@map("sports_ru_fantasy_contests")
}

model FantasyPlayerPrice {
  id               String   @id @default(cuid())
  leagueId         BigInt   @map("league_id")
  season           String
  teamId           BigInt?  @map("team_id")
  playerId         BigInt?  @map("player_id")
  provider         String   @default("SPORTS_RU")
  providerPlayerId String?  @map("provider_player_id")
  playerName       String   @map("player_name")
  normalizedName   String   @map("normalized_name")
  teamName         String   @default("") @map("team_name")
  sportsTeamName   String?  @map("sports_team_name")
  fotmobPlayerName String?  @map("fotmob_player_name")
  positionLabel    String?  @map("position_label")
  sourceKind       String?  @map("source_kind")
  sourceRowIndex   Int?     @map("source_row_index")
  position         String?
  price            Float
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")

  league CoreLeague  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   CoreTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player CorePlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([provider, leagueId, season, normalizedName, teamName])
  @@index([playerId, leagueId, season])
  @@index([teamId, leagueId, season])
  @@map("fantasy_player_prices")
}

model UserFantasySquad {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  leagueId      BigInt   @map("league_id")
  season        String
  name          String   @default("My squad")
  budgetLimit   Float    @default(100) @map("budget_limit")
  bank          Float    @default(0)
  horizonRounds Int      @default(5) @map("horizon_rounds")
  filters       Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  league  CoreLeague               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  players UserFantasySquadPlayer[]

  @@unique([userId, leagueId, season, name])
  @@index([userId, leagueId, season, updatedAt])
  @@index([leagueId, season])
  @@map("user_fantasy_squads")
}

model UserFantasySquadPlayer {
  id            String   @id @default(cuid())
  squadId       String   @map("squad_id")
  playerId      BigInt   @map("player_id")
  teamId        BigInt?  @map("team_id")
  position      String?
  isStarter     Boolean  @default(true) @map("is_starter")
  isLocked      Boolean  @default(false) @map("is_locked")
  isCaptain     Boolean  @default(false) @map("is_captain")
  isViceCaptain Boolean  @default(false) @map("is_vice_captain")
  slotIndex     Int      @default(0) @map("slot_index")
  purchasePrice Float?   @map("purchase_price")
  addedAt       DateTime @default(now()) @map("added_at")

