# Database
# If you change POSTGRES_PASSWORD, update the password in DATABASE_URL too.
POSTGRES_PASSWORD="replace-me"
FANTASY_HOST_PORT="3000"
FANTASY_POSTGRES_HOST_PORT="5433"
DATABASE_URL="postgresql://fantasy_app:replace-me@localhost:5433/fantasy_scout"

# Auth
# Custom cookie auth does not use NEXTAUTH_* variables.
# CRON_SECRET protects /api/cron/* routes and must be a long random value in production.
CRON_SECRET="replace-me"

# Uploads
UPLOAD_STORAGE="local"
LOCAL_UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="25"

# App
NEXT_PUBLIC_APP_NAME="Fantasy Scout"
DEFAULT_SEASON="2025/26"

# Feature flags
ENABLE_BULK_UPLOAD="true"
ENABLE_USER_SHORTLISTS="false"
ENABLE_API_FOOTBALL_PROVIDER="false"
ENABLE_WYSCOUT_API_PROVIDER="false"

# Machete FotMob provider boundary
# mock       = local seed data
# unofficial = direct fetch to FotMob public endpoints. The main ingestion
#              flow uses unsigned league/team/fixture endpoints plus the
#              unsigned next-data /match/{id}/playbyplay.json payload.
# real       = reserved for an approved/licensed provider adapter
MACHETE_FOTMOB_PROVIDER_MODE="mock"
MACHETE_FOTMOB_BASE_URL="https://www.fotmob.com/api"
MACHETE_FOTMOB_API_KEY=""
MACHETE_FOTMOB_CCODE3="GBR"
MACHETE_FOTMOB_TIMEZONE="Europe/London"
# Minimum spacing between requests to /api/data/*. Helps when the worker
# loops over many matches. 1500ms is the safe default.
MACHETE_FOTMOB_REQUEST_INTERVAL_MS="1500"
FOTMOB_PLAYER_ARCHIVE_BATCH_SIZE="75"
FOTMOB_PLAYER_ARCHIVE_REFRESH_DAYS="7"

# Optional. Only needed for the secondary getPlayer() path, which calls the
# signed and Turnstile-gated /api/data/playerData endpoint. Fixture details
# use unsigned next-data playbyplay payloads and do not need a cookie.
# To grab if you need it:
#   1. Open https://www.fotmob.com in Chrome and visit any match page.
#   2. DevTools -> Network -> click any /api/data/playerData request.
#   3. Right click -> Copy -> Copy as cURL -> grab the -H 'cookie: ...' value.
MACHETE_FOTMOB_COOKIE=""
# Optional. FotMob deploy marker used only by the signed getPlayer() fallback.
# Override only when that secondary path is used and the default in signing.ts is stale.
# Discover: curl -sI https://www.fotmob.com/api/data/leagues?id=47 | grep x-client-version
MACHETE_FOTMOB_DEPLOY_ID=""

# Optional override for the in-docker DATABASE_URL shared by ingestion
# services. Use this if your postgres role differs from the default
# (`fantasy_app`) defined in docker-compose.yml.
DATABASE_URL_INTERNAL=""

# Comma-separated FotMob fixture ids that should be skipped during discovery.
# Use this for individual matches where FotMob serves a page or matchDetails
# payload with a mismatched id (e.g. slug collisions). Example:
# MACHETE_FOTMOB_SKIP_FIXTURE_IDS="4813374,4813380"
MACHETE_FOTMOB_SKIP_FIXTURE_IDS=""

# Optional source-to-canonical league aliases for split FotMob tournaments.
# Format: canonical_id:source_id,source_id;canonical_id=source_id
# Example: MACHETE_FOTMOB_LEAGUE_ALIASES="42:12345;50:23456,23457"
MACHETE_FOTMOB_LEAGUE_ALIASES=""

# Required in beta/production to prove the raw-to-normalized update latency.
# Keep the existing prune commands in the operations schedule to bound growth.
MACHETE_STORE_RAW_PAYLOADS="true"

# Shared FotMob incremental ingestion
MACHETE_DAILY_SYNC_ENABLED="true"
MACHETE_DAILY_SYNC_TIME="03:00"
MACHETE_DAILY_SYNC_TIMEZONE="Europe/Moscow"
MACHETE_DAILY_SYNC_URL=""

# Shared FotMob league-season retention. On Jan 1 it prunes spring-autumn
# seasons outside the latest two-season window; on Jul 1 it prunes
# autumn-spring seasons outside the same two-season window.
LEAGUE_SEASON_RETENTION_ENABLED="true"
LEAGUE_SEASON_RETENTION_TIME="03:30"
LEAGUE_SEASON_RETENTION_TIMEZONE="Europe/Moscow"

# Daily persisted beta data-quality gate. Scopes use
# <FotMob league id>:<season>, separated by commas or semicolons.
# Keep scopes empty only outside beta/production environments.
DATA_QUALITY_AUDIT_ENABLED="true"
DATA_QUALITY_AUDIT_SCOPES=""
DATA_QUALITY_AUDIT_TIME="10:00"
DATA_QUALITY_AUDIT_TIMEZONE="Europe/Moscow"
DATA_QUALITY_AUDIT_COVERAGE_PERCENT="98"
DATA_QUALITY_AUDIT_MAXIMUM_LATENCY_HOURS="6"
DATA_QUALITY_AUDIT_MAXIMUM_RUN_AGE_HOURS="26"

# Critical browser-error health window. Only coarse anonymous counters are
# stored; any event inside this window makes the dedicated monitor critical.
CLIENT_CRITICAL_ERROR_WINDOW_MINUTES="60"

# Closed-beta composite acceptance gate. Missing or invalid evidence keeps the
# final gate closed; there are no permissive runtime defaults.
BETA_TEST_SERVER_AUDIT_URL=""
BETA_TEST_FIXED_WINDOW_EXPECTED_START=""
BETA_TEST_FIXED_WINDOW_MIN_SPAN_MINUTES="1440"
BETA_TEST_SERVER_AUDIT_MAX_AGE_MINUTES="90"
BETA_TEST_RUM_MIN_SPAN_HOURS="24"
BETA_TEST_RUM_MAX_AGE_HOURS="24"

# Current Sports.ru fantasy prices. Scopes use
# <FotMob league id>:<season>:<Sports.ru tournament HRU>.
# The sync runs once after startup and then at most every six hours. It fails
# closed and preserves existing rows when Sports.ru has no current season or
# returns an implausibly small player list.
SPORTS_RU_FANTASY_SYNC_ENABLED="true"
SPORTS_RU_FANTASY_SYNC_SCOPES="63:2026/2027:russia;87:2026/2027:spain;61:2026/2027:portugal;57:2026/2027:netherlands;71:2026/2027:turkey;48:2026/2027:championship"
SPORTS_RU_FANTASY_SYNC_INTERVAL_HOURS="6"
SPORTS_RU_FANTASY_MAXIMUM_AGE_HOURS="7"
SPORTS_RU_FANTASY_MINIMUM_PLAYERS="100"
SPORTS_RU_FANTASY_MINIMUM_MAPPED_PERCENT="98"

# Official Fantasy Premier League public bootstrap. The provider is scoped to
# the existing EPL CoreLeague 47 and uses no account credentials or cookies.
# Snapshots run at 00:01 and 12:01 Europe/London, including DST; startup runs
# a catch-up sync and then waits for the next wall-clock slot.
FPL_ENABLED="false"
FPL_PRICE_SYNC_ENABLED="false"
FPL_IMPORT_ENABLED="false"
# Optional internal, allowlisted relay whose own network namespace exits via VPN.
FPL_RELAY_SOCKET_PATH=""
FPL_PRICE_SYNC_TIMEOUT_MS="15000"
FPL_PRICE_SYNC_MAX_ATTEMPTS="3"
FPL_PRICE_SYNC_RETRY_BASE_DELAY_MS="500"
FPL_PRICE_SYNC_MIN_INTERVAL_MS="250"

# Foontasy xPts import. Credentials are deliberately not committed. The
# source currently publishes only its current-round forecast; FFO T3/T5 is
# shown only after forecasts for every requested round have been imported.
FOONTASY_SYNC_ENABLED="false"
FOONTASY_EMAIL=""
FOONTASY_PASSWORD=""
FOONTASY_SYNC_SCOPES="63:rpl;47:epl;87:la-liga;54:bundesliga;55:serie-a;53:ligue-1;57:eredivisie;61:liga-nos;71:super-lig;48:championship;42:champions-league-sports;42:champions-league-uefa;73:europa-league;77:world-cup"
FOONTASY_LEAGUE_ID="63"
FOONTASY_SEASON="2026/2027"
FOONTASY_URL="https://foontasy.ru/assistant/rpl"
FOONTASY_SOURCE_KEY="rpl"
FOONTASY_SOURCE_VARIANT="sports"
# An import is scheduled exactly 10 hours before the first match of every
# pending RPL round. If fixtures or Foontasy are temporarily unavailable, it
# retries in 30 minutes; this timezone is used only for the scheduled log.
FOONTASY_SYNC_TIMEZONE="Europe/Moscow"

# Public prematch team-total line. No API key is required. The provider feed is
# undocumented, so failures preserve the last snapshot and stale data is not
# used in fantasy formulas after 24 hours.
FIXTURE_ODDS_SYNC_ENABLED="true"
FIXTURE_ODDS_SYNC_INTERVAL_MINUTES="15"

# Point-in-time archive of the full Machete squad planning table. For every
# current fantasy league season and tour the whole player pool is stored
# exactly one minute before the first kickoff, ready for later comparisons
# with real fantasy results (npm run snapshots:squad). Tour boundaries come
# from the synced Sports.ru provider rounds; planning re-reads the schedule a
# few times per day and sets one precise timer per capture.
SQUAD_PLANNING_SNAPSHOT_ENABLED="true"

# Rotating CURRENT_XI squad player pools, distinct from the prematch archive.
# Worker only: every hour at :00 from 10 through 23 Europe/Moscow, plus a
# persistent dirty-team queue for manual/imported starting-XI changes.
# Initial publication: npm run snapshots:player-pool (or -- --league-id 48 --season 2026/2027).
FANTASY_PLAYER_POOL_SNAPSHOT_ENABLED="true"
# KHL is isolated and disabled until its source/readiness gates pass.
KHL_ENABLED=false
KHL_SYNC_ENABLED=false
KHL_STATS_SYNC_ENABLED=false
KHL_DAILY_STATS_ENABLED=false
# Full statistics cycle: ops/fantasy-khl-statistics.timer (10:00 / 20:00 Europe/Moscow).
# Odds/forecast freshness continues in the worker between full cycles.
KHL_FORECASTS_ENABLED=false

# SorareInside worker: hourly at :05; default disabled until credentials supplied.
SORAREINSIDE_SYNC_ENABLED=false
SORAREINSIDE_EMAIL=
SORAREINSIDE_PASSWORD=
