{
  "name": "fantasy-scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:safe-update": "tsx scripts/apply-safe-db-update.ts",
    "db:prod-update": "npm run db:safe-update && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "ingestion:status": "tsx scripts/ingestion-runner.ts status",
    "ingestion:queue-initial-backfill": "tsx scripts/ingestion-runner.ts queue-initial-backfill",
    "ingestion:initial-backfill": "tsx scripts/ingestion-runner.ts initial-backfill",
    "ingestion:queue-incremental-update": "tsx scripts/ingestion-runner.ts queue-incremental-update",
    "ingestion:incremental-update": "tsx scripts/ingestion-runner.ts incremental-update",
    "ingestion:run-next": "tsx scripts/ingestion-runner.ts run-next",
    "ingestion:worker": "tsx scripts/ingestion-runner.ts worker",
    "ingestion:reparse-raw": "tsx scripts/ingestion-runner.ts reparse-raw",
    "ingestion:import-payloads": "tsx scripts/ingestion-runner.ts import-payloads",
    "fotmob:smoke": "tsx scripts/fotmob-smoke.ts",
    "scores:recalculate": "tsx prisma/recalculate-fantasy.ts",
    "logos:download": "tsx scripts/download-team-logos.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
