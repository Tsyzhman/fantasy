[Unit]
Description=Fantasy Scout Caddy access-log audit
After=caddy.service
Requires=caddy.service

[Service]
Type=oneshot
User=caddy
Group=caddy
ExecStart=/usr/local/lib/fantasy-scout/run-caddy-access-audits.sh
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/caddy /usr/local/lib/fantasy-scout
ReadWritePaths=/var/lib/fantasy-scout-monitor

[Install]
WantedBy=multi-user.target
