[Unit]
Description=Collect H2H decisions and recalculate franchise analytics
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/bash /var/www/fantasy-scout-current/ops/franchises-sync.sh
TimeoutStartSec=5600
Nice=10

